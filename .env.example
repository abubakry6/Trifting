# SUPABASE CONFIGURATION
# Dapatkan dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-expose-to-frontend

# MIDTRANS PAYMENT GATEWAY
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
MIDTRANS_IS_PRODUCTION=false

# STORE CONFIGURATION
NEXT_PUBLIC_STORE_NAME="Trifting Official"
NEXT_PUBLIC_WA_CS="6281234567890"
